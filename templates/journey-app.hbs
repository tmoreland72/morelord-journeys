<section class="ml-app ml-app-shell ml-journeys-dashboard ml-journeys app-shell journey-shell">
  {{#unless hasJourney}}
    <header class="ml-hero"><i class="fa-solid fa-compass ml-hero__icon"></i><div class="ml-hero__body"><h1>{{localize "MORELORD_JOURNEYS.Name"}}</h1><p>{{localize "MORELORD_JOURNEYS.Planner.Intro"}}</p></div><div class="ml-actions"><button type="button" data-action="openDocumentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>
    <details class="ml-surface ml-collapsible-section journey-step-planner" data-ml-section-key="morelord-journeys.journey-steps" open>
      <summary>
      <div class="ml-section-heading"><div>
      <h2>Journey Steps</h2>
      <p>Choose the steps for this journey. Disabled steps are skipped and logged; Pace defaults to Normal and Navigation to success.</p>
      </div></div>
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </summary>
      <div class="ml-collapsible-section__body ml-grid" data-columns="2">
        {{#each journeySteps}}<label class="ml-toggle"><input type="checkbox" name="step-{{key}}" {{#if enabled}}checked{{/if}}><span>{{label}}</span></label>{{/each}}
      </div>
    </details>
    <section class="ml-stack journey-planner">
      <section class="ml-surface ml-stack journey-route-planner">
      <div class="ml-section-heading"><h2>{{localize "MORELORD_JOURNEYS.Planner.Journey"}}</h2></div>
      <div class="ml-grid" data-columns="2">
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Origin"}}</span><input name="origin" type="text" value="Starting Point" required></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Destination"}}</span><input name="destination" type="text" value="Destination" required></label>
        <fieldset class="ml-field-group journey-route-length"><legend>Route Length</legend><div class="ml-field-group__controls"><label><span>Days</span><input name="lengthDays" type="number" min="0" value="4"></label><label><span>Thirds</span><select name="lengthThirds"><option value="0">0</option><option value="1">⅓</option><option value="2">⅔</option></select></label></div></fieldset>
      </div>
      </section>
      <section class="ml-surface ml-stack journey-route-ratings">
      <div class="ml-section-heading"><h2>{{localize "MORELORD_JOURNEYS.Planner.RouteRatings"}}</h2></div>
      <div class="ml-grid ratings" data-columns="2">
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Danger"}}</span><input name="danger" type="number" min="0" max="5" value="2"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.DiscoveryDC"}}</span><input name="discoveryDC" type="number" min="0" value="15"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.ResourcesDC"}}</span><input name="resourcesDC" type="number" min="0" value="15"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.NavigationDC"}}</span><input name="navigationDC" type="number" min="0" value="10"></label>
      </div>
      </section>
      <div class="ml-actions journey-planner-actions">
        <button type="button" data-action="saveJourneyDefaults">Save as Default</button>
        <button type="button" data-action="createJourney"><i class="fa-solid fa-route"></i> {{localize "MORELORD_JOURNEYS.Actions.Create"}}</button>
      </div>
    </section>
  {{else}}
<header class="ml-hero ml-journeys-hero ml-journeys-dashboard-hero journey-dashboard-header"><div class="ml-hero__body"><h1>{{route.origin.name}} → {{route.destination.name}}</h1><p>{{localize "MORELORD_JOURNEYS.Day"}} {{displayDayNumber}}</p></div><div class="ml-actions"><button type="button" class="ml-icon-button ml-journeys-icon-button" data-action="clearJourney" aria-label="{{localize 'MORELORD_JOURNEYS.Actions.Clear'}}" data-tooltip="{{localize 'MORELORD_JOURNEYS.Actions.Clear'}}"><i class="fa-solid fa-trash"></i></button></div></header>
    <section class="ml-surface ml-stack journey-progress-dashboard" aria-label="Journey progress">
      <div class="ml-section-heading"><h2>Journey Progress</h2></div>
      <div class="ml-grid" data-columns="4">
        <div class="ml-card ml-stack" data-gap="1"><span class="ml-eyebrow">Days Traveled</span><strong>{{progress.daysCurrent}}</strong></div>
        <div class="ml-card ml-stack" data-gap="1"><span class="ml-eyebrow">Days Remaining</span><strong>{{progress.daysRemaining}}</strong></div>
        <div class="ml-card ml-stack" data-gap="1"><span class="ml-eyebrow">Original Duration</span><strong>{{progress.originalDaysTotal}} days</strong></div>
        <div class="ml-card ml-stack" data-gap="1"><span class="ml-eyebrow">Current Duration</span><strong>{{progress.daysTotal}} days</strong></div>
      </div>
      {{#if canAdjustRemaining}}
      <details class="ml-details"><summary>Adjust Remaining Travel</summary><div class="ml-details__body ml-stack">
        <p>Change the remaining travel before the next day begins. Original duration and days already traveled stay the same. Setting zero marks the destination reached.</p>
        <div class="ml-grid" data-columns="2"><label><span>Days remaining</span><input type="number" name="remainingDays" min="0" step="1" value="{{remainingDays}}"></label><label><span>Additional thirds</span><select name="remainingThirds">{{#each remainingThirds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
        <div class="ml-actions"><button type="button" data-action="adjustRemainingTravel">Apply Adjustment</button></div>
      </div></details>
      {{/if}}
    </section>
    {{#if isArrived}}
      <section class="ml-empty-state"><i class="fa-solid fa-location-dot journey-large-icon"></i><h2>{{localize "MORELORD_JOURNEYS.Arrived.Title"}}</h2><p>{{localize "MORELORD_JOURNEYS.Arrived.Message" destination=route.destination.name}}</p><button type="button" data-action="endJourney"><i class="fa-solid fa-flag-checkered"></i> End Journey</button></section>
    {{else if canBeginDay}}
      <section class="ml-empty-state"><i class="fa-solid fa-sun journey-large-icon"></i><h2>{{localize "MORELORD_JOURNEYS.Ready.Title"}}</h2><p>{{localize "MORELORD_JOURNEYS.Ready.Message"}}</p><button type="button" data-action="beginDay">{{localize "MORELORD_JOURNEYS.Actions.BeginDay"}}</button></section>
      <details class="ml-surface ml-collapsible-section journey-daily-ratings" data-ml-section-key="morelord-journeys.daily-route-ratings" open>
        <summary><div class="ml-section-heading"><div><h2>Daily Route Ratings</h2><p>Adjust the environment for the next travel day. Begin Travel Day saves these ratings for that day and carries them forward as the next day's defaults.</p></div></div><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></summary>
        <div class="ml-collapsible-section__body ml-grid" data-columns="2">
          <label><span>Danger</span><input type="number" name="danger" min="0" max="5" value="{{route.danger}}"></label>
          <label><span>Discovery DC</span><input type="number" name="discoveryDC" min="0" max="50" value="{{route.discoveryDC}}"></label>
          <label><span>Resources DC</span><input type="number" name="resourcesDC" min="0" max="50" value="{{route.resourcesDC}}"></label>
          <label><span>Navigation DC</span><input type="number" name="navigationDC" min="0" max="50" value="{{route.navigationDC}}"></label>
        </div>
      </details>
    {{else}}
      <nav class="journey-phases" aria-label="Journey phases">{{#each phases}}<span class="{{#if active}}active{{/if}} {{#if complete}}complete{{/if}}" data-tooltip="{{label}}" aria-label="{{label}}" {{#if active}}aria-current="step"{{/if}}>{{#if complete}}<i class="fa-solid fa-check"></i>{{else}}{{number}}{{/if}}</span>{{/each}}</nav>
      <section class="ml-surface ml-stack journey-phase-card">
        <div class="ml-section-heading"><div><h2>{{phaseLabel}}</h2><p>{{localize "MORELORD_JOURNEYS.CurrentPhase"}}</p></div></div>
        {{#if phaseIs.weather}}<div class="ml-stack journey-weather-generator"><label><span>Season</span><select name="weatherSeason"><option value="warm">Spring / Summer</option><option value="cold">Fall / Winter</option></select></label><div class="ml-grid" data-columns="2"><section class="ml-card ml-stack"><h3>Extreme Weather</h3><div class="ml-audit-card journey-weather-result">{{#if extremeWeatherCheck}}<strong>{{#if extremeWeatherCheck.extreme}}Extreme Weather{{else}}Ordinary Weather{{/if}}</strong>{{else}}<span>Extreme-weather check pending.</span>{{/if}}</div><div class="ml-cluster"><button type="button" data-action="rollExtremeWeather">Roll Extreme Weather</button><label class="ml-toggle journey-check"><input name="extremeWeather" type="checkbox" {{#if weather.extreme}}checked{{else}}{{#if extremeWeatherCheck.extreme}}checked{{/if}}{{/if}}><span>Override: extreme weather</span></label></div></section><section class="ml-card ml-stack"><h3>Daily Weather</h3><div class="ml-audit-card journey-weather-result" data-weather-result>{{#if weather}}<strong>{{weather.label}}</strong><small>{{weather.detail}}</small>{{else}}<span>No forecast generated.</span>{{/if}}</div><button type="button" data-action="rollWeatherForecast">{{#if weather}}Reroll Forecast{{else}}Roll Forecast{{/if}}</button></section></div>{{#if extremeWeatherCheck}}<details class="ml-details journey-outcome-details"><summary>Outcome Details</summary><div class="ml-details__body"><article class="ml-audit-card"><strong>Extreme Weather Check</strong><dl class="ml-data-list"><div><dt>Roll</dt><dd>{{extremeWeatherCheck.roll}}</dd></div><div><dt>Trigger</dt><dd>1 on 1d20</dd></div><div><dt>Outcome</dt><dd>{{#if extremeWeatherCheck.extreme}}Extreme weather{{else}}Ordinary weather{{/if}}</dd></div></dl></article>{{#if weather}}<article class="ml-audit-card"><strong>Weather Forecast</strong><dl class="ml-data-list"><div><dt>Table roll</dt><dd>{{weather.roll}}</dd></div><div><dt>Season</dt><dd>{{weather.season}}</dd></div><div><dt>Weather class</dt><dd>{{#if weather.extreme}}Extreme{{else}}Ordinary{{/if}}</dd></div><div><dt>Outcome</dt><dd>{{weather.label}}</dd></div></dl></article>{{/if}}</div></details>{{/if}}</div>{{/if}}
        {{#if phaseIs.pace}}<label><span>{{localize "MORELORD_JOURNEYS.Inputs.Pace"}}</span><select name="pace"><option value="slow">{{localize "MORELORD_JOURNEYS.Paces.slow"}}</option><option value="normal" selected>{{localize "MORELORD_JOURNEYS.Paces.normal"}}</option><option value="fast">{{localize "MORELORD_JOURNEYS.Paces.fast"}}</option><option value="stopped">{{localize "MORELORD_JOURNEYS.Paces.stopped"}}</option></select></label>{{/if}}
        {{#if phaseIs.discovery}}<div class="ml-stack journey-discovery-tools"><p>Describe a clue, not the full discovery, then let the party decide whether to investigate.</p>{{#if discoveryCheckSucceeded}}<div class="ml-stack journey-discovery-lead"><div class="ml-cluster journey-discovery-roll"><button type="button" data-action="rollDiscoveryLead">Roll Discovery Lead</button><button type="button" class="ml-icon-button journey-help-button" data-size="compact" data-variant="ghost" data-action="showDiscoveryOutcomes" aria-label="Explain discovery outcomes" data-tooltip="Explain discovery outcomes"><i class="fa-solid fa-circle-question"></i></button></div>{{#if discoveryLead}}<div class="ml-audit-card journey-weather-result"><strong>{{discoveryLead.category}}</strong><small>{{discoveryLead.example}}</small></div><details class="ml-details journey-outcome-details"><summary>Outcome Details</summary><div class="ml-details__body"><article class="ml-audit-card"><strong>Discovery Lead</strong><dl class="ml-data-list"><div><dt>Raw d100</dt><dd>{{discoveryLead.roll}}</dd></div><div><dt>Result band maximum</dt><dd>{{discoveryLead.maximum}}</dd></div><div><dt>Outcome</dt><dd>{{discoveryLead.category}}</dd></div></dl></article></div></details>{{/if}}</div>{{/if}}<fieldset class="ml-field-group journey-discovery-cost"><legend>Time Cost <button type="button" class="ml-icon-button journey-help-button" data-size="compact" data-variant="ghost" data-discovery-time-help aria-label="Explain Discovery time cost" data-tooltip="Explain Discovery time cost"><i class="fa-solid fa-circle-question"></i></button></legend><div class="ml-field-group__controls"><label><span>Days</span><input name="discoveryCostDays" type="number" min="0" step="1" value="0"></label><label><span>Thirds</span><select name="discoveryCostThirds"><option value="0">0</option><option value="1">⅓</option><option value="2">⅔</option></select></label></div></fieldset></div>{{/if}}
        {{#if phaseIs.navigation}}<div data-navigation-result></div>{{/if}}
        {{#if phaseIs.pressOn}}<div class="ml-stack journey-press-on"><div class="journey-press-on-control"><label class="ml-toggle journey-check"><input name="pressedOn" type="checkbox" {{#if journey.currentDay.pressedOn}}checked{{/if}}><span>Press On</span></label><button type="button" data-action="requestForcedMarchRolls" hidden><i class="fa-solid fa-person-running"></i> {{#if pressOnDC}}Request Party Saves{{else}}Resolve Automatic Success{{/if}}</button></div><small>Press on for two hours (+⅓ day); {{#if pressOnDC}}each traveler makes a DC {{pressOnDC}} Constitution save and gains 1 Exhaustion on failure.{{else}}DC 0 succeeds automatically; no roll is needed.{{/if}}</small>{{#if forcedMarch.pending.length}}<div class="journey-forced-march-requests">{{#each forcedMarch.pending}}<div><strong>{{{identityHtml}}}</strong><span>DC {{dc}} pending</span><button type="button" data-action="resendForcedMarch" data-request-id="{{id}}">Resend</button><button type="button" data-action="autoForcedMarchFailure" data-request-id="{{id}}">Fail</button><button type="button" data-action="autoForcedMarchSuccess" data-request-id="{{id}}">Succeed</button></div>{{/each}}</div>{{/if}}{{#if forcedMarch.results.length}}<ul>{{#each forcedMarch.results}}<li>{{{identityHtml}}}: {{#if succeeded}}success{{else}}failure; +1 Exhaustion{{/if}}</li>{{/each}}</ul>{{/if}}</div>{{/if}}
        {{#if isDayComplete}}<button type="button" data-action="completeDay">{{localize "MORELORD_JOURNEYS.Actions.CompleteDay"}}</button>{{else}}<button type="button" data-action="advancePhase">{{localize "MORELORD_JOURNEYS.Actions.Continue"}}</button>{{/if}}
      </section>
    {{/if}}
    {{#if canGoBack}}<footer class="ml-page-footer ml-actions"><button type="button" data-action="goBack"><i class="fa-solid fa-arrow-left"></i> Go Back</button></footer>{{/if}}
    {{#if recentLog.length}}<section class="ml-surface ml-stack journey-log"><div class="ml-section-heading"><h2>{{localize "MORELORD_JOURNEYS.Log.Title"}}</h2></div><ol>{{#each recentLog}}<li><span><strong>{{label}}</strong>{{#if result}} — {{result}}{{/if}}</span><small>{{localize "MORELORD_JOURNEYS.Day"}} {{dayNumber}}</small></li>{{/each}}</ol></section>{{/if}}
  {{/unless}}
</section>
