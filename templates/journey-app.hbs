<section class="ml-app ml-app-shell ml-journeys-dashboard ml-journeys app-shell ml-journeys-dashboard journey-shell">
  {{#unless hasJourney}}
    <header class="ml-hero ml-journeys-hero ml-journeys-dashboard-hero journey-hero"><i class="fa-solid fa-person-hiking"></i><div class="ml-hero__body"><h1>{{localize "MORELORD_JOURNEYS.Planner.Title"}}</h1><p>{{localize "MORELORD_JOURNEYS.Planner.Intro"}}</p></div></header>
    <section class="journey-planner">
      <h2>{{localize "MORELORD_JOURNEYS.Planner.Journey"}}</h2>
      <div class="journey-grid two-columns">
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.JourneyName"}}</span><input name="journeyName" type="text" value="Expedition" required></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.RouteName"}}</span><input name="routeName" type="text" value="The Open Road" required></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Origin"}}</span><input name="origin" type="text" value="Starting Point" required></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Destination"}}</span><input name="destination" type="text" value="Destination" required></label>
      </div>
      <h2>{{localize "MORELORD_JOURNEYS.Planner.RouteRatings"}}</h2>
      <div class="journey-grid ratings">
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.LengthDays"}}</span><input name="lengthDays" type="number" min="0" value="4"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.LengthThirds"}}</span><select name="lengthThirds"><option value="0">0</option><option value="1">⅓</option><option value="2">⅔</option></select></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.Danger"}}</span><input name="danger" type="number" min="0" max="5" value="2"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.DiscoveryDC"}}</span><input name="discoveryDC" type="number" min="0" value="15"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.ResourcesDC"}}</span><input name="resourcesDC" type="number" min="0" value="15"></label>
        <label><span>{{localize "MORELORD_JOURNEYS.Fields.NavigationDC"}}</span><input name="navigationDC" type="number" min="0" value="10"></label>
        <label><span>Route traffic</span><select name="routeTraffic"><option value="ordinary">Ordinary / remote</option><option value="high">Road or high traffic (+5 encounters)</option></select></label>
      </div>
      <button type="button" data-action="createJourney"><i class="fa-solid fa-route"></i> {{localize "MORELORD_JOURNEYS.Actions.Create"}}</button>
    </section>
  {{else}}
<header class="ml-hero ml-journeys-hero ml-journeys-dashboard-hero journey-dashboard-header"><div class="ml-hero__body"><p class="journey-eyebrow">{{route.origin.name}} → {{route.destination.name}}</p><h1>{{journey.name}}</h1><p>{{route.name}} · {{localize "MORELORD_JOURNEYS.Day"}} {{journey.dayNumber}}</p></div><button type="button" class="ml-icon-button ml-journeys-icon-button" data-action="clearJourney" aria-label="{{localize 'MORELORD_JOURNEYS.Actions.Clear'}}" data-tooltip="{{localize 'MORELORD_JOURNEYS.Actions.Clear'}}"><i class="fa-solid fa-trash"></i></button></header>
<section class="ml-surface ml-journeys-panel journey-card"><div class="journey-progress-label"><strong>{{progress.daysRemaining}} days remaining <small>({{progress.daysCurrent}} traveled; original route {{progress.originalDaysTotal}} days)</small></strong><span>{{progress.percent}}%</span></div><div class="ml-progress journey-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress.percent}}"><span class="ml-progress__fill" style="width: {{progress.percent}}%"></span></div></section>
    {{#if isArrived}}
      <section class="ml-card ml-journeys-panel journey-card journey-centered"><i class="fa-solid fa-location-dot journey-large-icon"></i><h2>{{localize "MORELORD_JOURNEYS.Arrived.Title"}}</h2><p>{{localize "MORELORD_JOURNEYS.Arrived.Message" destination=route.destination.name}}</p></section>
    {{else if canBeginDay}}
      <section class="ml-card ml-journeys-panel journey-card journey-centered"><i class="fa-solid fa-sun journey-large-icon"></i><h2>{{localize "MORELORD_JOURNEYS.Ready.Title"}}</h2><p>{{localize "MORELORD_JOURNEYS.Ready.Message"}}</p><button type="button" data-action="beginDay">{{localize "MORELORD_JOURNEYS.Actions.BeginDay"}}</button></section>
    {{else}}
      <nav class="journey-phases">{{#each phases}}<span class="{{#if active}}active{{/if}} {{#if complete}}complete{{/if}}" data-tooltip="{{label}}">{{#if complete}}<i class="fa-solid fa-check"></i>{{else}}{{number}}{{/if}}</span>{{/each}}</nav>
      <section class="ml-card ml-journeys-panel journey-card journey-phase-card">
        <p class="journey-eyebrow">{{localize "MORELORD_JOURNEYS.CurrentPhase"}}</p><h2>{{phaseLabel}}</h2>
        {{#if phaseIs.weather}}<div class="journey-weather-generator"><p>First determine extreme weather, then roll a compatible forecast.</p><div class="journey-weather-result">{{#if extremeWeatherCheck}}<strong>{{#if extremeWeatherCheck.extreme}}Extreme Weather{{else}}Ordinary Weather{{/if}}</strong>{{else}}<span>Extreme-weather check pending.</span>{{/if}}</div><div class="journey-inline-actions"><button type="button" data-action="rollExtremeWeather">Roll Extreme Weather</button><label class="journey-check"><input name="extremeWeather" type="checkbox" {{#if weather.extreme}}checked{{else}}{{#if extremeWeatherCheck.extreme}}checked{{/if}}{{/if}}><span>Override: extreme weather</span></label></div><label><span>Season</span><select name="weatherSeason"><option value="warm">Spring / Summer</option><option value="cold">Fall / Winter</option></select></label><div class="journey-weather-result" data-weather-result>{{#if weather}}<strong>{{weather.label}}</strong><small>{{weather.detail}}</small>{{else}}<span>No forecast generated.</span>{{/if}}</div><button type="button" data-action="rollWeatherForecast">{{#if weather}}Reroll Forecast{{else}}Roll Forecast{{/if}}</button>{{#if extremeWeatherCheck}}<details class="journey-outcome-details"><summary>Outcome Details</summary><div class="journey-outcome-details-body"><article class="journey-outcome-detail-card"><strong>Extreme Weather Check</strong><dl><div><dt>Roll</dt><dd>{{extremeWeatherCheck.roll}}</dd></div><div><dt>Trigger</dt><dd>1 on 1d20</dd></div><div><dt>Outcome</dt><dd>{{#if extremeWeatherCheck.extreme}}Extreme weather{{else}}Ordinary weather{{/if}}</dd></div></dl></article>{{#if weather}}<article class="journey-outcome-detail-card"><strong>Weather Forecast</strong><dl><div><dt>Table roll</dt><dd>{{weather.roll}}</dd></div><div><dt>Season</dt><dd>{{weather.season}}</dd></div><div><dt>Weather class</dt><dd>{{#if weather.extreme}}Extreme{{else}}Ordinary{{/if}}</dd></div><div><dt>Outcome</dt><dd>{{weather.label}}</dd></div></dl></article>{{/if}}</div></details>{{/if}}</div>{{/if}}
        {{#if phaseIs.pace}}<label><span>{{localize "MORELORD_JOURNEYS.Inputs.Pace"}}</span><select name="pace"><option value="slow">{{localize "MORELORD_JOURNEYS.Paces.slow"}}</option><option value="normal" selected>{{localize "MORELORD_JOURNEYS.Paces.normal"}}</option><option value="fast">{{localize "MORELORD_JOURNEYS.Paces.fast"}}</option><option value="stopped">{{localize "MORELORD_JOURNEYS.Paces.stopped"}}</option></select></label>{{/if}}
        {{#if phaseIs.discovery}}<div class="journey-discovery-tools"><p>Describe a clue, not the full discovery, then let the party decide whether to investigate.</p>{{#if discoveryCheckSucceeded}}<div class="journey-discovery-lead"><div class="journey-inline-actions journey-discovery-roll"><button type="button" data-action="rollDiscoveryLead">Roll Discovery Lead</button><button type="button" class="journey-help-button" data-action="showDiscoveryOutcomes" aria-label="Explain discovery outcomes" data-tooltip="Explain discovery outcomes"><i class="fa-solid fa-circle-question"></i></button></div>{{#if discoveryLead}}<div class="journey-weather-result"><strong>{{discoveryLead.category}}</strong><small>{{discoveryLead.example}}</small></div><details class="journey-outcome-details"><summary>Outcome Details</summary><div class="journey-outcome-details-body"><article class="journey-outcome-detail-card"><strong>Discovery Lead</strong><dl><div><dt>Raw d100</dt><dd>{{discoveryLead.roll}}</dd></div><div><dt>Result band maximum</dt><dd>{{discoveryLead.maximum}}</dd></div><div><dt>Outcome</dt><dd>{{discoveryLead.category}}</dd></div></dl></article></div></details>{{/if}}</div>{{/if}}<div class="journey-discovery-cost"><label><span>Time cost — days</span><input name="discoveryCostDays" type="number" min="0" step="1" value="0"></label><label><span>Additional thirds</span><select name="discoveryCostThirds"><option value="0">No additional thirds</option><option value="1">+ ⅓ day</option><option value="2">+ ⅔ day</option></select></label></div><small>A cost greater than zero means the party pursued the discovery. Use zero when it was ignored or the check failed.</small></div>{{/if}}
        {{#if phaseIs.navigation}}<label><span>{{localize "MORELORD_JOURNEYS.Inputs.NavigationOutcome"}}</span><select name="navigationOutcome"><option value="success">Success — apply progress</option><option value="lost">Lost — no progress</option><option value="reversed">Turned Around — lose one day</option></select></label>{{/if}}
        {{#if phaseIs.pressOn}}<div class="journey-press-on"><div class="journey-press-on-control"><label class="journey-check"><input name="pressedOn" type="checkbox"><span>Press On</span></label><button type="button" data-action="requestForcedMarchRolls" hidden><i class="fa-solid fa-person-running"></i> Request Party Saves</button></div><small>Press on for two hours (+⅓ day); each traveler makes a DC 12 Constitution save and gains 1 Exhaustion on failure.</small>{{#if forcedMarch.pending.length}}<div class="journey-forced-march-requests">{{#each forcedMarch.pending}}<div><strong>{{actorName}}</strong><span>DC {{dc}} pending</span><button type="button" data-action="resendForcedMarch" data-request-id="{{id}}">Resend</button><button type="button" data-action="autoForcedMarchFailure" data-request-id="{{id}}">Fail</button><button type="button" data-action="autoForcedMarchSuccess" data-request-id="{{id}}">Succeed</button></div>{{/each}}</div>{{/if}}{{#if forcedMarch.results.length}}<ul>{{#each forcedMarch.results}}<li>{{actorName}}: {{#if succeeded}}success{{else}}failure; +1 Exhaustion{{/if}}</li>{{/each}}</ul>{{/if}}</div>{{/if}}
        {{#if isDayComplete}}<button type="button" data-action="completeDay">{{localize "MORELORD_JOURNEYS.Actions.CompleteDay"}}</button>{{else}}<button type="button" data-action="advancePhase">{{localize "MORELORD_JOURNEYS.Actions.Continue"}}</button>{{/if}}
      </section>
    {{/if}}
    {{#if recentLog.length}}<section class="ml-card ml-journeys-panel journey-card journey-log"><h2>{{localize "MORELORD_JOURNEYS.Log.Title"}}</h2><ol>{{#each recentLog}}<li><span><strong>{{label}}</strong>{{#if result}} — {{result}}{{/if}}</span><small>{{localize "MORELORD_JOURNEYS.Day"}} {{dayNumber}}</small></li>{{/each}}</ol></section>{{/if}}
  {{/unless}}
</section>
